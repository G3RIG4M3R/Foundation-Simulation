<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE experiments SYSTEM "behaviorspace.dtd">
<experiments><experiment name="Confirmatory trader-attractiveness tipping grid" repetitions="20" runMetricsEveryStep="false">
  <setup>random-seed (500000 + behaviorspace-run-number) setup</setup>
  <go>go</go><timeLimit steps="1000"/><exitCondition>ticks &gt;= active-tick-limit</exitCondition>
  <metric>control-fraction</metric><metric>controlled-planets</metric><metric>controlled-kingdoms</metric>
  <metric>mean-religion</metric><metric>mean-dependency</metric><metric>cumulative-trade-profit</metric>
  <metric>total-successful-trades</metric><metric>total-executed-missionaries</metric><metric>total-executed-traders</metric>
  <metric>ticks</metric><metric>active-tick-limit</metric><metric>model-valid?</metric>
  <metric>500000 + behaviorspace-run-number</metric>
  <enumeratedValueSet variable="tick-limit"><value value="1000"/></enumeratedValueSet>
  <enumeratedValueSet variable="missionary-effectiveness"><value value="0.5"/></enumeratedValueSet>
  <enumeratedValueSet variable="royal-intolerance"><value value="0"/></enumeratedValueSet>
  <enumeratedValueSet variable="initial-missionaries"><value value="12"/></enumeratedValueSet>
  <enumeratedValueSet variable="initial-traders"><value value="8"/><value value="12"/><value value="16"/><value value="20"/><value value="24"/></enumeratedValueSet>
  <enumeratedValueSet variable="trade-attractiveness"><value value="0.6"/><value value="0.8"/><value value="1"/></enumeratedValueSet>
  <enumeratedValueSet variable="tech-decay-rate"><value value="0.015"/></enumeratedValueSet>
  <enumeratedValueSet variable="religion-trade-weight"><value value="0.8"/></enumeratedValueSet>
  <enumeratedValueSet variable="independence-effort"><value value="0.15"/></enumeratedValueSet>
  <enumeratedValueSet variable="view-mode"><value value="&quot;kingdom&quot;"/></enumeratedValueSet>
</experiment></experiments>
